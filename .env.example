# Environment Configuration for the Portal
# Copy this file to .env and update the values for your environment

# Database Configuration
# For container-to-container communication (use 'postgres' for Docker, 'localhost' for local)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=portal
DB_USERNAME=portal
DB_PASSWORD=your_secure_password_here

# External PostgreSQL port (for host access, pgAdmin, etc.)
DB_PORT_EXTERNAL=5432

# Application Configuration
APP_IMAGE=d4c-portal:latest
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# First-run platform administrator (required for fresh production deployments).
# Created automatically on first startup when no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_admin_password
ADMIN_EMAIL=admin@example.com

# Seed sample organizations/users/connectors (development only; never in production)
DEMO_DATA_ENABLED=false

# Encryption key for sensitive data at rest (SPIP passwords stored in database)
# MUST be exactly 32 characters for AES-256 encryption
# Generate with: openssl rand -base64 24 | tr -d '\n' | cut -c1-32
# WARNING: Changing this key will make existing encrypted data unreadable!
ENCRYPTION_KEY=change_this_32_char_key_in_prod!

# Optional: Custom JVM Options
JAVA_OPTS=-Xmx1g -Xms512m

# Optional: Logging Level
LOGGING_LEVEL=INFO

# SPIP Platform Configuration
# Base URL for SPIP platform API
SPIP_BASE_URL=https://spip.example.com:8002

# SPIP customer tag/identifier (provided by your SPIP operator)
SPIP_CUSTOMER_TAG=your_customer_tag

# SPIP admin credentials for platform initialization
SPIP_ADMIN_USERNAME=your_spip_admin_username
SPIP_ADMIN_PASSWORD=your_spip_admin_password

# SPIP role assigned to newly onboarded users.
# IMPORTANT: must be the exact name of a role that exists on your SPIP
# instance (ask your SPIP operator). If it does not match, onboarding fails
# at the role-assignment step with: 400 {"error":"Unable to assign role"}
SPIP_DEFAULT_ROLE=data_owner

CKAN_BASE_URL=https://ckan.example.com
# Browser-facing CKAN address used for outgoing links (e.g. the dashboard
# use-case "Explore Data" buttons). Only needed when it differs from
# CKAN_BASE_URL — e.g. CKAN_BASE_URL uses a Docker-internal hostname.
# Defaults to CKAN_BASE_URL when unset.
#CKAN_PUBLIC_URL=https://ckan.example.com
CKAN_JWT_TOKEN=your_ckan_jwt_token
# CKAN JWT Token for API authentication.
# Obtain a valid token from the CKAN admin interface or via the CKAN API.
# The token should have sufficient permissions (e.g., admin or required API scopes).
# CKAN organization name used as default owner for published datasets
CKAN_ORGANIZATION=your_ckan_organization

# Keycloak Identity Provider Configuration
# Default Keycloak instance used to provision organization groups and first users
# during onboarding. The platform admin can override the instance per organization
# on the onboarding sync form. For local development, docker-compose.keycloak.yml
# provides an instance matching these defaults on port 8081.
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=data4circ
# Confidential client with a service account holding the realm-management roles
# manage-users, view-users, query-users and query-groups.
KEYCLOAK_ADMIN_CLIENT_ID=portal-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=your_keycloak_client_secret
#KEYCLOAK_DISABLE_SSL_VERIFICATION=false
# Mirror the first user's portal password into Keycloak at first-login activation
# (best-effort: Keycloak being down or rejecting the password never blocks the
# portal flow; only identities on the default instance above are mirrored).
#KEYCLOAK_MIRROR_PORTAL_PASSWORD=false

# Onboarding tool toggles (all default to enabled; keycloak defaults to optional).
# required=false lets admins approve onboarding requests without synchronizing
# that tool; enabled=false hides the tool entirely.
# NOTE: enabled=false makes required irrelevant for that tool (a disabled tool can
# never be "required") — do not set both false expecting a stronger disable than
# enabled=false alone. CKAN's own sync additionally depends on SPIP only while SPIP
# is required=true; once SPIP is optional or disabled, CKAN provisions its own
# username/password instead of reusing SPIP's.
#ONBOARDING_TOOL_SPIP_ENABLED=true
#ONBOARDING_TOOL_SPIP_REQUIRED=true
#ONBOARDING_TOOL_CKAN_ENABLED=true
#ONBOARDING_TOOL_CKAN_REQUIRED=true
#ONBOARDING_TOOL_KEYCLOAK_ENABLED=true
#ONBOARDING_TOOL_KEYCLOAK_REQUIRED=false

# SSL certificate verification (set to false in production with proper certificates)
SPIP_DISABLE_SSL_VERIFICATION=true

# Email Configuration (any SMTP provider)
EMAIL_ENABLED=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
APP_EMAIL_FROM=noreply@example.com

# Comma-separated list of reviewer email addresses that receive a notification
# when a new onboarding request is submitted. Leave empty to disable.
# Example: ONBOARDING_REVIEWERS=alice@example.com,bob@example.com
ONBOARDING_REVIEWERS=

# Additional CORS origins allowed to call the API (comma-separated).
# Set this to the public URL of the portal so the public join form can
# submit onboarding requests to the API backend.
# Example: CORS_ADDITIONAL_ORIGINS=https://portal.example.com
CORS_ADDITIONAL_ORIGINS=

# Automatic connector initialization for newly onboarded organizations.
# Define the connector list in application-{profile}.yml; this flag enables it.
CONNECTOR_INIT_ENABLED=false

# Optional: File Storage Configuration
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=10MB

# OpenTelemetry Configuration (optional observability)
# Endpoint of your OTLP-compatible collector (e.g. SigNoz, Jaeger, Grafana)
OTEL_EXPORTER_OTLP_ENDPOINT=http://your-otel-collector:4317
# Protocol to use: grpc (default, port 4317) or http/protobuf (port 4318)
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Service name to identify this application in your observability backend
OTEL_SERVICE_NAME=portal
# Resource attributes for additional metadata (environment, namespace, etc.)
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=portal
# Enable/disable specific telemetry types
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# Enable instrumentation for specific components
OTEL_INSTRUMENTATION_JDBC_ENABLED=true
OTEL_INSTRUMENTATION_SPRING_WEB_ENABLED=true
OTEL_INSTRUMENTATION_SPRING_WEBMVC_ENABLED=true
# Java agent configuration (automatically set, should not be modified)
JAVA_TOOL_OPTIONS=-javaagent:/app/opentelemetry-javaagent.jar

# =============================================================================
# White-Label Branding Configuration
# =============================================================================
# Configure client-specific branding without code changes
# See docs/developer/WHITE-LABEL-DEPLOYMENT.md for complete guide

# Brand Identity
# -----------------------------------------------------------------------------
# Organization or product name displayed throughout the portal
BRANDING_NAME=Portal for Circularity
# Short tagline or slogan (1-5 words)
BRANDING_TAGLINE=Circular Economy Data Platform
# Detailed description (1-2 sentences)
BRANDING_SUBTAGLINE=Integrate data catalog functionality with SPIP capabilities for circular economy data management.
# Support contact shown in outgoing emails (hidden when empty)
BRANDING_SUPPORT_EMAIL=
# Email sign-off name (defaults to "The <brand name> Team")
BRANDING_TEAM_NAME=
# Copyright line owner in email footers (defaults to the brand name)
BRANDING_COPYRIGHT_HOLDER=

# Color Scheme (Hex Format Required: #RRGGBB)
# -----------------------------------------------------------------------------
# Primary brand color (login box, main elements)
BRANDING_COLOR_PRIMARY=#1E5AA8
# Secondary color (backgrounds, accents)
BRANDING_COLOR_SECONDARY=#2F3E4E
# Accent color (buttons, links, highlights)
BRANDING_COLOR_ACCENT=#A8C6E8
# Info/data color (links, technology elements)
BRANDING_COLOR_INFO=#0E7490
# Success message color
BRANDING_COLOR_SUCCESS=#2E7D32
# Warning message color
BRANDING_COLOR_WARNING=#ED6C02
# Error/danger message color
BRANDING_COLOR_DANGER=#C62828
# Main text color
BRANDING_COLOR_TEXT=#1F2933
# Secondary text color (captions, hints)
BRANDING_COLOR_LIGHT_TEXT=#6D7485

# Typography
# -----------------------------------------------------------------------------
# Body font stack (CSS font-family format)
BRANDING_FONT_FAMILY="'Open Sans', Arial, sans-serif"
# Heading font
BRANDING_HEADING_FONT_FAMILY="'Montserrat', 'Open Sans', Arial, sans-serif"

# Branding Assets
# -----------------------------------------------------------------------------
# Path or URL to full logo (400x150px recommended)
BRANDING_LOGO=/assets/branding/logo.png
# Path or URL to small logo for navbar (120x40px, rendered at 30px height)
BRANDING_LOGO_SMALL=/assets/branding/logo-small.png
# Path or URL to favicon (32x32px ICO format)
BRANDING_FAVICON=/assets/branding/favicon.png
# Optional login page background image
BRANDING_LOGIN_BACKGROUND=

# Navbar Styling
# -----------------------------------------------------------------------------
# Navbar background color
BRANDING_NAVBAR_BACKGROUND=#2F3E4E
# Navbar text and link color
BRANDING_NAVBAR_TEXT_COLOR=#FFFFFF

# =============================================================================
# Example Themes
# =============================================================================
# Uncomment one of these example theme sets to quick-start with a preset theme

# --- Teal Green Theme ---
# BRANDING_NAME=Your Company Portal
# BRANDING_TAGLINE=Circular Economy Data Platform
# BRANDING_COLOR_PRIMARY=#00AA78
# BRANDING_COLOR_SECONDARY=#2B463C
# BRANDING_COLOR_ACCENT=#8FD9C0
# BRANDING_NAVBAR_BACKGROUND=#2B463C

# --- Eco Green Theme ---
# BRANDING_NAME=EcoMaterials Exchange
# BRANDING_TAGLINE=Sustainable Resource Sharing
# BRANDING_COLOR_PRIMARY=#2E7D32
# BRANDING_COLOR_SECONDARY=#1B5E20
# BRANDING_COLOR_ACCENT=#81C784
# BRANDING_NAVBAR_BACKGROUND=#1B5E20

# --- Industrial Gray Theme ---
# BRANDING_NAME=Industrial Materials Hub
# BRANDING_TAGLINE=B2B Resource Marketplace
# BRANDING_COLOR_PRIMARY=#455A64
# BRANDING_COLOR_SECONDARY=#263238
# BRANDING_COLOR_ACCENT=#FF6F00
# BRANDING_NAVBAR_BACKGROUND=#263238

# =============================================================================
# Notes
# =============================================================================
# 1. All colors must be in hex format: #RRGGBB (e.g., #1E5AA8)
# 2. Asset paths can be local (/assets/...) or CDN URLs (https://...)
# 3. To apply changes: docker-compose up -d (or restart application)
# 4. Clear browser cache after changes: Ctrl+F5 or Cmd+Shift+R
# 5. Test at: http://localhost:8080/login
# =============================================================================
