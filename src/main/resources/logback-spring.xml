<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="d4c-portal"/>

    <!-- Console appender with trace context for SigNoz correlation -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [trace_id=%X{trace_id} span_id=%X{span_id}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Profile-specific logging levels -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.data4circ.portal" level="DEBUG"/>
        <logger name="org.springframework.security" level="DEBUG"/>
    </springProfile>

    <springProfile name="docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.data4circ.portal" level="${LOGGING_LEVEL:-INFO}"/>
        <logger name="com.data4circ.portal.features.organization.service.OnboardingRequestService" level="DEBUG"/>
        <logger name="com.data4circ.portal.features.organization.controller.OrganizationController" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.data4circ.portal" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
    </springProfile>

    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.data4circ.portal" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>
    </springProfile>

    <!-- Default (fallback) -->
    <springProfile name="default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.data4circ.portal" level="INFO"/>
        <logger name="com.data4circ.portal.features.organization.service.OnboardingRequestService" level="DEBUG"/>
        <logger name="com.data4circ.portal.features.organization.controller.OrganizationController" level="INFO"/>
        <logger name="org.springframework.security" level="DEBUG"/>
    </springProfile>
</configuration>
